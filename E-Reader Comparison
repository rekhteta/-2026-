    <!-- Interactive JS Logic -->
    <script>
        // DOM Elements
        const readingHoursRange = document.getElementById('reading-hours-range');
        const readingHoursVal = document.getElementById('reading-hours-val');
        const brightnessRange = document.getElementById('brightness-range');
        const brightnessVal = document.getElementById('brightness-val');

        const daysBooxPageEl = document.getElementById('days-boox-page');
        const progressBooxPageEl = document.getElementById('progress-boox-page');
        const daysBigmeEl = document.getElementById('days-bigme');
        const progressBigmeEl = document.getElementById('progress-bigme');
        const daysMeebookEl = document.getElementById('days-meebook');
        const progressMeebookEl = document.getElementById('progress-meebook');
        const daysPokeEl = document.getElementById('days-poke');
        const progressPokeEl = document.getElementById('progress-poke');

        // State variables
        let dailyReadingHours = parseFloat(readingHoursRange.value);
        let wifiSetting = 'smart'; // Default: auto timeout
        let brightnessLevel = parseInt(brightnessRange.value);

        // Core calculation logic simulating Android e-ink discharge behavior
        // Total mA capacity: Onyx Page (2300), Bigme B751 (2300), Meebook (2900), Poke 5 (1500)
        // Standby drain per day (with Wi-Fi):
        //   - always: 5% (Onyx/Meebook), 8% (Bigme), 6% (Poke 5)
        //   - smart: 1.5% (Onyx/Meebook), 2.5% (Bigme), 2% (Poke 5)
        //   - off: 0.8% (Onyx/Meebook), 1.5% (Bigme), 1% (Poke 5)
        // Active usage drain per hour (with backlight factor):
        //   - Base active screen refresh: ~1.2% per hour
        //   - Wi-Fi active factor (always on): +1.8% per hour
        //   - Backlight factor: up to +1.5% per hour at 100% brightness

        function calculateBatteryLife() {
            // Devices configurations
            const devices = {
                booxPage: {
                    capacity: 2300,
                    efficiency: 1.0, // Best background app management
                    baseStandby: 1.2, // % per day off
                    baseActive: 2.2, // % per hour active screen (no wifi, no light)
                },
                bigme: {
                    capacity: 2300,
                    efficiency: 1.4, // Higher power drain (octa core MTK, less background freeze)
                    baseStandby: 2.0,
                    baseActive: 3.2,
                },
                meebook: {
                    capacity: 2900,
                    efficiency: 0.95, // Big battery + quad core
                    baseStandby: 1.1,
                    baseActive: 2.4,
                },
                poke: {
                    capacity: 1500,
                    efficiency: 1.1, // Small battery
                    baseStandby: 1.5,
                    baseActive: 2.8,
                }
            };

            // Calculate multipliers based on inputs
            let wifiStandbyFactor = 1.0;
            let wifiActiveFactor = 0.0;
            if (wifiSetting === 'always') {
                wifiStandbyFactor = 3.5;
                wifiActiveFactor = 2.0;
            } else if (wifiSetting === 'smart') {
                wifiStandbyFactor = 1.2;
                wifiActiveFactor = 0.3;
            } else {
                wifiStandbyFactor = 0.8;
                wifiActiveFactor = 0.0;
            }

            const brightnessFactor = (brightnessLevel / 100) * 1.5;

            // Compute for each device
            for (const [key, dev] of Object.entries(devices)) {
                // Standby drain % per day
                const standbyDrainPercent = dev.baseStandby * wifiStandbyFactor;
                // Active usage drain % per hour
                const activeDrainPercent = (dev.baseActive + wifiActiveFactor + brightnessFactor) * dev.efficiency;

                // Daily drain = standby for remaining 24 hours + active usage
                const activeTime = dailyReadingHours;
                const standbyTimeFraction = (24 - activeTime) / 24;

                const dailyTotalPercent = (standbyDrainPercent * standbyTimeFraction) + (activeDrainPercent * activeTime);
                
                // Estimated days = 100% / daily total percent
                let days = Math.round(100 / dailyTotalPercent);

                // Cap logically
                if (days < 1) days = 1;
                if (days > 45) days = 45; // Max standby limits for android e-ink

                // UI mapping
                if (key === 'booxPage') {
                    daysBooxPageEl.innerHTML = `${days} <span class="text-sm font-medium text-slate-500">днів</span>`;
                    progressBooxPageEl.style.width = `${Math.min(100, (days / 45) * 100)}%`;
                } else if (key === 'bigme') {
                    daysBigmeEl.innerHTML = `${days} <span class="text-sm font-medium text-slate-500">днів</span>`;
                    progressBigmeEl.style.width = `${Math.min(100, (days / 45) * 100)}%`;
                } else if (key === 'meebook') {
                    daysMeebookEl.innerHTML = `${days} <span class="text-sm font-medium text-slate-500">днів</span>`;
                    progressMeebookEl.style.width = `${Math.min(100, (days / 45) * 100)}%`;
                } else if (key === 'poke') {
                    daysPokeEl.innerHTML = `${days} <span class="text-sm font-medium text-slate-500">днів</span>`;
                    progressPokeEl.style.width = `${Math.min(100, (days / 45) * 100)}%`;
                }
            }
        }

        // Event Listeners for controls
        readingHoursRange.addEventListener('input', (e) => {
            dailyReadingHours = parseFloat(e.target.value);
            readingHoursVal.innerText = dailyReadingHours === 0.5 ? '30 хв' : `${dailyReadingHours} год`;
            calculateBatteryLife();
        });

        brightnessRange.addEventListener('input', (e) => {
            brightnessLevel = parseInt(e.target.value);
            brightnessVal.innerText = `${brightnessLevel}%`;
            calculateBatteryLife();
        });

        window.setWifi = function(mode) {
            wifiSetting = mode;
            // Update button styles
            document.querySelectorAll('.wifi-btn').forEach(btn => {
                btn.className = 'wifi-btn px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition';
            });
            const activeBtn = document.getElementById(`wifi-${mode}`);
            if (activeBtn) {
                activeBtn.className = 'wifi-btn px-3 py-1.5 text-xs font-semibold rounded-lg border border-indigo-600 bg-indigo-50 text-indigo-700 transition';
            }
            calculateBatteryLife();
        };

        // Initial launch
        window.addEventListener('DOMContentLoaded', () => {
            calculateBatteryLife();
        });
    </script>
